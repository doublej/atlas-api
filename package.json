{
  "name": "atlas-api",
  "description": "Scan and index development projects. Exposes JSON API at /api/projects",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "bun --bun vite build",
    "preview": "vite preview",
    "scan": "bun src/lib/scanner.ts",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest --passWithNoTests",
    "lint": "biome check . && stylelint '**/*.{css,svelte}'",
    "lint:fix": "biome check --write . && stylelint --fix '**/*.{css,svelte}'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.48.5",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^25.9.1",
    "postcss-html": "^1.0.0",
    "stylelint": "^17.0.0",
    "svelte": "^5.46.4",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.159",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@openai/codex-sdk": "^0.136.0",
    "@xyflow/svelte": "^1.5.2",
    "dagre": "^0.8.5"
  }
}
