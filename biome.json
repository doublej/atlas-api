{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/.mcp.json", "!**/.template-meta.json", "!src/app.html"]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 10 }
        },
        "noForEach": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/lib/scanner.ts",
        "src/lib/claude-tree.ts",
        "src/lib/claude-tree-entities.ts",
        "src/lib/templates.ts",
        "src/lib/umami.ts",
        "src/lib/domains.ts",
        "src/lib/ports.ts",
        "src/routes/api/**",
        "src/routes/claude-tree/**",
        "src/routes/+page.svelte"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "useLiteralKeys": "off"
          },
          "style": {
            "useTemplate": "off"
          },
          "suspicious": {
            "noImplicitAnyLet": "off",
            "noAssignInExpressions": "off"
          },
          "correctness": {
            "noInnerDeclarations": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
