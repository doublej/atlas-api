<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jurrejan.atlas-api</string>
    <!-- Serves the adapter-node build, never `vite dev`. A dev server needs ~20s to
         bind and ~50s to compile its first response; every health check read that as
         "dead" and SIGKILLed it mid-boot, which trashed vite's dep cache and made the
         next boot slower still. The build boots in ~0.3s. Rebuild with `bun run daemon:reload`. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/jurrejan/.bun/bin/bun</string>
        <string>build/index.js</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/jurrejan/dev/multi-stack/project-atlas/atlas-api</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/atlas-api.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/atlas-api.error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/jurrejan/.bun/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>ATLAS_DAEMON_WRITE</key>
        <string>1</string>
        <key>PORT</key>
        <string>47891</string>
        <key>HOST</key>
        <string>127.0.0.1</string>
    </dict>
</dict>
</plist>
